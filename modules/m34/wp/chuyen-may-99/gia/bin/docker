#!/usr/bin/env bash
# docker GIẢ: trạng thái máy giả trong $GIA_MAY_DIR (chay = dịch vụ đang chạy, db = "CSDL" dạng TSV bảng<TAB>số dòng,
# vol/<tên> = volume). Ghi mọi lệnh vào $GIA_MAY_DIR/docker.log.
# Như compose thật, `compose exec -T` đọc hết stdin của người gọi (kể cả pg_dump, psql không cần): kịch bản phải tự chặn.
# Ca hỏng: GIA_HONG_UP=<máy> (up hỏng), GIA_HONG_NAP (pg_restore .99 mất dòng cuối), GIA_HONG_VOL (m34_uploads .99 thêm tệp lạ).
set -euo pipefail
D=${GIA_MAY_DIR:?}
printf '%s\n' "$*" >> "$D/docker.log"
DV="pg redis clamav be fe nginx m8that-bi-mat m8that-cb"
chay_file="$D/chay"; touch "$chay_file"
them_chay() { for s in "$@"; do grep -qx "$s" "$chay_file" || echo "$s" >> "$chay_file"; done; }
bo_chay() { local t; t=$(mktemp); grep -vxF -f <(printf '%s\n' "$@") "$chay_file" > "$t" || true; mv "$t" "$chay_file"; }
case "${1-}" in
  info) echo /data/docker; exit 0 ;;
  version) echo 29.1.3; exit 0 ;;
  pull) exit 0 ;;
  image) echo "sha256:gia-anh-$(echo "$*" | sha256sum | cut -c1-12)"; exit 0 ;;
  inspect)
    case "$*" in
      *Config.Env*)
        # env be giả = .env thư mục hiện tại (tạo lại be = đọc .env); GIA_OPS_TAT=1: be không bật OPS_CORE; GIA_OPS_DE=<url>: override đặt đè
        [ -n "${GIA_OPS_TAT:-}" ] || echo OPS_CORE_ENABLED=true
        if [ -n "${GIA_OPS_DE:-}" ]; then echo "OPS_CORE_BASE_URL=$GIA_OPS_DE"
        else { sed -nE 's/^(export[[:space:]]+)?(OPS_CORE_BASE_URL=)/\2/p' .env 2>/dev/null || true; } | tail -n 1; fi
        exit 0 ;;
      *) echo "sha256:gia-anh"; exit 0 ;;
    esac ;;
  volume)
    case "${2-}" in
      inspect) [ -d "$D/vol/${3-}" ] ;;
      *) ls "$D/vol" 2>/dev/null ;;
    esac
    exit ;;
  network) echo "172.24.8.0/22 "; exit 0 ;;
  system) for v in $(ls "$D/vol" 2>/dev/null); do echo "$v 1 1MB"; done; exit 0 ;;
  run)
    shift; vol=''; ep=''; nhap=0
    while [ $# -gt 0 ]; do
      case $1 in
        --rm|--network) [ "$1" = --network ] && shift; shift ;;
        -i) nhap=1; shift ;;
        -v) vol=${2%%:*}; shift 2 ;;
        --entrypoint) ep=$2; shift 2 ;;
        postgres:17) shift; break ;;
        *) shift ;;
      esac
    done
    dir="$D/vol/$vol"; mkdir -p "$dir"
    if [ "$ep" = tar ]; then
      # tar -C /v --numeric-owner -cpf - .   |   tar -C /v --numeric-owner -xpf -
      case " $* " in
        *" -cpf - "*) tar -C "$dir" -cf - . ;;
        *" -xpf - "*)
          tar -C "$dir" -xf -
          if [ -n "${GIA_HONG_VOL:-}" ] && [ "$GIA_MAY" = 99 ] && [ "$vol" = m34_uploads ]; then echo rac > "$dir/rac.bin"; fi ;;
        *) echo "docker giả: tar lạ: $*" >&2; exit 2 ;;
      esac
    elif [ "$ep" = bash ]; then
      # thu_ops_core: thử TCP từ m34_app tới OPS_CORE; GIA_OPS_KHONG_THONG=1 giả đường bị chặn
      if [ -n "${GIA_OPS_KHONG_THONG:-}" ]; then exit 1; fi
      # GIA_OPS_THONG_LAN=<n>: n lượt thử đầu thông, từ lượt n+1 không thông (đếm ở $D/ops-dem)
      if [ -n "${GIA_OPS_THONG_LAN:-}" ]; then
        n=$(( $(cat "$D/ops-dem" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$D/ops-dem"
        [ "$n" -le "$GIA_OPS_THONG_LAN" ] || exit 1
      fi
      exit 0
    elif [ "$ep" = sh ]; then
      [ "$1" = -c ] || { echo "docker giả: sh lạ" >&2; exit 2; }
      kb=${2//\/v/$dir}
      sh -c "$kb"
    else
      echo "docker giả: run lạ" >&2; exit 2
    fi
    exit 0 ;;
  compose) shift ;;
  *) exit 0 ;;
esac
# ---- docker compose ----
case "${1-}" in
  version) echo 2.40.3; exit 0 ;;
  config)
    case "${2-}" in --services) printf '%s\n' m8that-cb; sleep 0.2; printf '%s\n' pg redis clamav be fe nginx m8that-bi-mat ;; --images) echo "ghcr.io/phucapu/ginsengfood-business-platform/bp-backend:gia" ;; esac
    exit 0 ;;
  pull) exit 0 ;;
  create) for v in m34_pg m34_redis m34_clamav m34_uploads m34_mail; do mkdir -p "$D/vol/$v"; done; exit 0 ;;
  up)
    [ -n "${GIA_HONG_UP:-}" ] && [ "$GIA_HONG_UP" = "$GIA_MAY" ] && { echo "up giả: hỏng" >&2; exit 1; }
    for v in m34_pg m34_redis m34_clamav m34_uploads m34_mail; do mkdir -p "$D/vol/$v"; done
    if [ ! -f "$D/db" ]; then                      # lần đầu (A8, CSDL rỗng): Flyway tạo lược đồ, redis có rác lượt thử
      printf 'flyway_schema_history\t350\n' > "$D/db"
      echo "redis-a8" > "$D/vol/m34_redis/dump-$GIA_MAY.rdb"
      mkdir -p "$D/vol/m34_uploads/seed"; echo seed1 > "$D/vol/m34_uploads/seed/s1.png"   # be tự sinh tệp seed (thật: 34 seed + 60 content)
    fi
    mkdir -p "$D/vol/m34_uploads/media"            # be tạo thư mục, không tạo tệp
    them_chay $DV; exit 0 ;;
  start) them_chay $DV; exit 0 ;;
  stop) shift; if [ $# -eq 0 ]; then : > "$chay_file"; else bo_chay "$@"; fi; exit 0 ;;
  ps)
    shift
    if [ "${1-}" = -q ]; then
      # ps -q --status running <dv>
      s=${4-}; grep -qx "$s" "$chay_file" && echo "id-$s" || true; exit 0
    fi
    for s in $DV; do if grep -qx "$s" "$chay_file"; then echo "  $s running healthy"; else echo "  $s exited"; fi; done
    exit 0 ;;
  logs)
    case " $* " in
      *" nginx"*) printf '192.168.1.10 - - [x] "GET / HTTP/1.1" 200\n192.168.1.10 - - [x] "GET /vi HTTP/1.1" 200\n' ;;
      *) printf '2026-11-13 INFO Started\n[IVR-AUTH-CONFIG] tls=PINNED token-client=ON callback-verifier=ON\n' ;;
    esac
    exit 0 ;;
  exec)
    shift; [ "$1" = -T ] && shift; shift   # bỏ -T pg
    case "$1" in
      pg_dump) cat > /dev/null; cat "$D/db" ;;
      pg_restore)
        if [ "${2-}" = --list ]; then cat > /dev/null; printf ';\n; gia\n1; 2615 2200 SCHEMA - public\n2; 1259 1 TABLE public bang\n'
        else
          cat > "$D/db"
          if [ -n "${GIA_HONG_NAP:-}" ] && [ "$GIA_MAY" = 99 ]; then sed -i '$d' "$D/db"; fi
        fi ;;
      dropdb) cat > /dev/null; rm -f "$D/db" ;;
      createdb) cat > /dev/null; : > "$D/db" ;;
      psql)
        cat > /dev/null
        case "$*" in
          *query_to_xml*) [ -f "$D/db" ] || exit 1; sort "$D/db" ;;
          *flyway_schema_history*) echo "350 0 349" ;;
          *) : ;;
        esac ;;
      *) echo "exec giả lạ: $*" >&2; exit 2 ;;
    esac
    exit 0 ;;
  *) exit 0 ;;
esac
